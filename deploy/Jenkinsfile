pipeline {
  agent { label 'v-collab-stg' }
  options {
    timestamps()
  }
  stages {
    stage('Deloy Stg') {
      when {
        beforeOptions true
        anyOf {
          environment name: 'gitlabBranch', value: 'stg'
          environment name: 'gitlabBranch', value: 'feature/refactor_code'
        }
      }
      steps {
        gitlabCommitStatus('Deloy Stg') {
          sh 'sudo /home/zulip/deployments/current/deploy/install.sh'
          sh 'sudo -u zulip /home/zulip/deployments/current/deploy/deploy.sh'
        }
      }
    }
  }
}
